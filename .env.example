# Copy this file to .env and fill in a key. .env is git-ignored - never commit it.

# Which service writes the answers: openrouter (free models) or anthropic (Claude, paid)
LLM_PROVIDER=openrouter

# --- OpenRouter (free) --- key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model ending in :free from https://openrouter.ai/models?q=free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Anthropic (Claude) --- key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is much cheaper per question
PAPERTRAIL_MODEL=claude-opus-5-5

# Where the data files live (keep this inside WSL, not under /mnt/c)
PAPERTRAIL_DATA=~/rag-data

# CPU threads for embedding questions and building the index (i7-13620H: try 8)
PAPERTRAIL_THREADS=8

# Cache: redis or off. Redis address (localhost when it runs on this machine).
CACHE=redis
REDIS_URL=redis://localhost:6379/0

# How questions are embedded: onnx-int8 (fastest, default), onnx, openvino, onnx-int8-avx2, openvino-int8, torch.
# All but torch need the one-time export: ~/.venvs/papertrail-export/bin/python scripts/export_encoder.py
EMBED_BACKEND=onnx-int8

# Reranker: a cross-encoder re-sorts 40 candidates before the LLM (about +1.5 s per question). on or off.
# Needs: ~/.venvs/papertrail-export/bin/python scripts/export_reranker.py minilm
RERANK=off

# Feedback: negative ratings are reviewed by three models (ANALYST_MODEL, REVIEWER_MODEL, ACTOR_MODEL).
FEEDBACK_REVIEW=on
FEEDBACK_DAILY_REVIEWS=10
