# Copy this file to .env and fill in your key. .env is git-ignored.
ANTHROPIC_API_KEY=

# Claude model used to write answers. claude-haiku-5-5 is much cheaper per question.
PAPERTRAIL_MODEL=claude-opus-5-5

# Where vectors.npy and papers.parquet live (keep this inside WSL, not under /mnt/c)
PAPERTRAIL_DATA=~/rag-data

# CPU threads for embedding questions and building the index (i7-13620H: try 8)
PAPERTRAIL_THREADS=8
